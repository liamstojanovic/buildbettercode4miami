{
  "name": "laser-focus",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "preinstall": "node scripts/check-toolchain.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "dev:container": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "verify": "node scripts/verify.mjs",
    "sheets:bridge": "node --env-file-if-exists=.env.local --import tsx scripts/sheets-bridge.ts"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@openai/agents": "0.21.0",
    "lucide-react": "0.468.0",
    "next": "16.4.5",
    "openai": "7.53.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.19.0",
    "npm": "12.0.2"
  },
  "packageManager": "npm@12.0.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
