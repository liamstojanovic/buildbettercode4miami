/** @OnlyCurrentDoc */
/* Laser Focus bound Google Sheets adapter. Credentials stay in UserProperties. */
var LASER_FOCUS_CONFIG_KEY_ = 'laser-focus.connection.v1';
var LASER_FOCUS_SOURCE_KEY_ = 'laser-focus.selection.v1';
var LASER_FOCUS_EXPORT_KEY_ = 'laser-focus.approved-export.v1';

function onOpen() {
  SpreadsheetApp.getUi().createMenu('Laser Focus')
    .addItem('Open sidebar', 'openLaserFocus')
    .addItem('Create fictional demo data', 'createLaserFocusDemo')
    .addToUi();
}

function openLaserFocus() {
  SpreadsheetApp.getUi().showSidebar(HtmlService.createHtmlOutputFromFile('Sidebar').setTitle('Laser Focus'));
}

function laserFocusContext() {
  var workbook = SpreadsheetApp.getActiveSpreadsheet();
  var config = laserFocusConfig_(false);
  var source = laserFocusStoredSource_();
  var result = { configured: Boolean(config), backendUrl: config ? config.url : '', workbookId: workbook.getId(), selection: source };
  if (source) {
    try { laserFocusPinnedSelection_(); }
    catch (error) { result.selectionError = error.message; }
  }
  return result;
}

function laserFocusConfigure(input) {
  if (!input || typeof input.url !== 'string' || typeof input.token !== 'string') throw new Error('Enter the bridge HTTPS address and connection token.');
  var url = input.url.trim().replace(/\/$/, '');
  var match = /^https:\/\/([a-z0-9.-]+)(?::443)?$/i.exec(url);
  if (!match || match[1].length > 253 || match[1].indexOf('.') < 0 || match[1].split('.').some(function (label) { return !/^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$/i.test(label); })) {
    throw new Error('Use the bridge HTTPS origin only, without a path, credentials, query or fragment.');
  }
  var token = input.token.trim();
  if (!/^[A-Za-z0-9_-]{32,200}$/.test(token)) throw new Error('Use the connection token generated by the Laser Focus bridge.');
  PropertiesService.getUserProperties().setProperty(LASER_FOCUS_CONFIG_KEY_, JSON.stringify({ url: url, token: token }));
  return laserFocusContext();
}

/** Explicit user action: capture only this contiguous range, including its header. */
function laserFocusReadSelection() {
  var workbook = SpreadsheetApp.getActiveSpreadsheet();
  var ranges = workbook.getActiveRangeList();
  if (ranges && ranges.getRanges().length !== 1) throw new Error('Select one contiguous donation table, including its header row.');
  var range = workbook.getActiveRange();
  if (!range) throw new Error('Select donation rows with their column headers first.');
  var selection = laserFocusSnapshot_(workbook, range);
  var summary = laserFocusSelectionSummary_(selection);
  PropertiesService.getUserProperties().setProperty(LASER_FOCUS_SOURCE_KEY_, JSON.stringify(summary));
  return { selection: selection, summary: summary };
}

/** The browser supplies an action, never authoritative workbook cells or identity. */
function laserFocusCommand(command) {
  if (!command || typeof command !== 'object' || Array.isArray(command)) throw new Error('Choose a Laser Focus action.');
  var allowed = ['status', 'preview', 'import', 'merge', 'generate', 'edit', 'approve', 'export', 'reset'];
  if (allowed.indexOf(command.action) < 0) throw new Error('Unknown Laser Focus action.');
  var input = {};
  Object.keys(command).forEach(function (key) { if (key !== 'selection' && key !== 'workbookId') input[key] = command[key]; });
  input.workbookId = SpreadsheetApp.getActiveSpreadsheet().getId();
  if (command.action !== 'status' && command.action !== 'reset') input.selection = laserFocusPinnedSelection_();
  var result = laserFocusRequest_(input);
  if (command.action === 'reset') PropertiesService.getUserProperties().deleteProperty(LASER_FOCUS_SOURCE_KEY_);
  // A spreadsheet can change while the backend is working. Never show its output
  // as applicable to the sheet until the observed source range is checked again.
  if (input.selection) laserFocusAssertUnchanged_(input.selection);
  return result;
}

/** Writes the server-approved export into one new tab; retries reuse that tab. */
function laserFocusWriteReport(input) {
  if (!input || typeof input.draftId !== 'string' || !Number.isSafeInteger(input.revision) || input.revision < 1) throw new Error('Choose the exact approved draft revision before writing.');
  var source = laserFocusPinnedSelection_();
  var result = laserFocusRequest_({ action: 'export', workbookId: source.workbookId, selection: source, draftId: input.draftId, revision: input.revision });
  var exported = result && result.export;
  if (!exported || exported.draftId !== input.draftId || exported.revision !== input.revision || !/^[a-f0-9]{64}$/.test(exported.approvalDigest || '') || exported.sourceHash !== laserFocusHash_(source)) {
    throw new Error('The export does not match this selected source and approved revision. Refresh and review the draft.');
  }
  var rows = laserFocusExportRows_(exported.rows);
  laserFocusAssertUnchanged_(source);
  var lock = LockService.getDocumentLock();
  if (!lock || !lock.tryLock(10000)) throw new Error('Another Laser Focus write is running. Wait briefly and retry.');
  try {
    laserFocusAssertUnchanged_(source);
    var workbook = SpreadsheetApp.getActiveSpreadsheet();
    var exportKey = exported.draftId + ':' + exported.revision + ':' + exported.approvalDigest;
    var name = 'Laser Focus report ' + exported.draftId.replace(/[^A-Za-z0-9]/g, '').slice(0, 12) + ' r' + exported.revision + ' ' + exported.approvalDigest.slice(0, 6);
    var prior = workbook.getSheetByName(name);
    if (prior) {
      var marker = laserFocusExportMarker_(prior);
      if (!marker || marker.key !== exportKey) throw new Error('A tab already uses this report name. Rename that tab before exporting; Laser Focus will not overwrite it.');
      if (marker.contentHash !== laserFocusHash_(rows)) throw new Error('The earlier export marker does not match this report. Review the saved tab before retrying.');
      if (marker.complete) {
        laserFocusVerifyWrittenRows_(prior, rows);
        return { sheetName: prior.getName(), url: workbook.getUrl() + '#gid=' + prior.getSheetId(), replayed: true };
      }
      // A prior execution stopped mid-write. It is safer to ask for inspection
      // than overwrite a tab that a person may have edited in the meantime.
      throw new Error('An earlier write stopped before completion. Inspect and rename that report tab, then retry.');
    }
    var created = workbook.insertSheet(name);
    var markerValue = { key: exportKey, contentHash: laserFocusHash_(rows), complete: false };
    created.addDeveloperMetadata(LASER_FOCUS_EXPORT_KEY_, JSON.stringify(markerValue));
    try {
      var written = created.getRange(1, 1, rows.length, rows[0].length);
      written.setNumberFormat('@');
      written.setValues(rows.map(function (row) { return row.map(laserFocusLiteralCell_); }));
      written.setWrap(true).setVerticalAlignment('top');
      created.getRange(1, 1, 1, rows[0].length).setBackground('#123f38').setFontColor('#ffffff').setFontWeight('bold');
      created.setFrozenRows(1);
      created.setColumnWidths(1, rows[0].length, rows[0].length === 1 ? 640 : 360);
      SpreadsheetApp.flush();
      laserFocusAssertUnchanged_(source);
      laserFocusVerifyWrittenRows_(created, rows);
      markerValue.complete = true;
      var metadata = created.getDeveloperMetadata().filter(function (item) { return item.getKey() === LASER_FOCUS_EXPORT_KEY_; });
      metadata[0].setValue(JSON.stringify(markerValue));
      SpreadsheetApp.flush();
    } catch (error) {
      // Leave the new tab marked incomplete for inspection. Never delete or alter
      // an existing tab, even if another editor changed it during this execution.
      throw new Error('The report tab was created but could not be verified. Inspect and rename it before retrying. ' + error.message);
    }
    workbook.setActiveSheet(created);
    return { sheetName: created.getName(), url: workbook.getUrl() + '#gid=' + created.getSheetId(), replayed: false };
  } finally { lock.releaseLock(); }
}

/** A known fictional fixture. Existing tabs and source rows are never replaced. */
function createLaserFocusDemo() {
  var workbook = SpreadsheetApp.getActiveSpreadsheet();
  var base = 'Laser Focus demo gifts';
  var name = base;
  for (var suffix = 2; workbook.getSheetByName(name); suffix++) name = base + ' ' + suffix;
  var sheet = workbook.insertSheet(name);
  var rows = [
    ['Gift ID', 'Donor ID', 'Donor name', 'Email', 'Phone', 'Amount', 'Gift date', 'Channel'],
    ['gift-online-101', 'donor-rosa-online', 'Rosa Delgado', 'rosa@example.test', '+1-305-555-0101', 125, '2026-07-10', 'online'],
    ['gift-ticket-201', 'donor-rosa-tickets', 'Rosa M. Delgado', 'rosa@example.test', '+1-305-555-0101', 80, '2026-08-03', 'tickets'],
    ['gift-auction-301', 'donor-rosa-auction', 'R. Delgado', 'rosa@example.test', '', 250, '2026-09-06', 'auction'],
    ['gift-check-401', 'donor-rosa-online', 'Rosa Delgado', 'rosa@example.test', '+1-305-555-0101', 50, '2026-09-20', 'check'],
    ['gift-check-402', 'donor-rosa-other', 'Rosa Delgado', 'another.rosa@example.test', '+1-305-555-0199', 30, '2026-09-21', 'check'],
    ['gift-jules-july', 'donor-jules', 'Jules Pierre', 'jules@example.test', '+1-305-555-0112', 50, '2026-07-28', 'online'],
    ['gift-jules-august', 'donor-jules', 'Jules Pierre', 'jules@example.test', '+1-305-555-0112', 50, '2026-08-28', 'online']
  ];
  var range = sheet.getRange(1, 1, rows.length, rows[0].length);
  range.setNumberFormat('@').setValues(rows.map(function (row) { return row.map(function (value) { return typeof value === 'string' ? laserFocusLiteralCell_(value) : value; }); }));
  sheet.getRange(2, 6, rows.length - 1, 1).setNumberFormat('$0.00');
  sheet.getRange(1, 1, 1, rows[0].length).setBackground('#123f38').setFontColor('#ffffff').setFontWeight('bold');
  sheet.setFrozenRows(1);
  sheet.autoResizeColumns(1, rows[0].length);
  sheet.getRange(1, 1).setNote('All people and gifts are fictional. Amount is in dollars. Select this complete table, including headers, then open Laser Focus.');
  workbook.setActiveSheet(sheet);
  workbook.setActiveRange(range);
  SpreadsheetApp.flush();
  return laserFocusReadSelection();
}

function laserFocusConfig_(required) {
  var raw = PropertiesService.getUserProperties().getProperty(LASER_FOCUS_CONFIG_KEY_);
  var config = raw ? JSON.parse(raw) : null;
  if (required && !config) throw new Error('Connect the Laser Focus bridge in Settings first.');
  return config;
}

function laserFocusStoredSource_() {
  var raw = PropertiesService.getUserProperties().getProperty(LASER_FOCUS_SOURCE_KEY_);
  return raw ? JSON.parse(raw) : null;
}

function laserFocusSelectionSummary_(selection) {
  return { workbookId: selection.workbookId, sheetId: selection.sheetId, sheetName: selection.sheetName, a1: selection.a1,
    startRow: selection.startRow, startColumn: selection.startColumn, rowCount: selection.values.length - 1, columnCount: selection.values[0].length, hash: laserFocusHash_(selection) };
}

function laserFocusSnapshot_(workbook, range) {
  if (range.getNumRows() < 2 || range.getNumRows() > 1001 || range.getNumColumns() < 1 || range.getNumColumns() > 32) throw new Error('Select a header plus 1–1,000 donation rows, with no more than 32 columns.');
  var timezone = workbook.getSpreadsheetTimeZone();
  var values = range.getValues().map(function (row) {
    return row.map(function (value) {
      if (Object.prototype.toString.call(value) === '[object Date]') return Utilities.formatDate(value, timezone, 'yyyy-MM-dd');
      if (value === null || typeof value === 'boolean') return value;
      if (typeof value === 'number' && isFinite(value)) return value;
      if (typeof value === 'string' && value.length <= 2000) return value;
      throw new Error('A selected cell has an unsupported value or exceeds 2,000 characters.');
    });
  });
  return { workbookId: workbook.getId(), sheetId: range.getSheet().getSheetId(), sheetName: range.getSheet().getName(), a1: range.getA1Notation(),
    startRow: range.getRow(), startColumn: range.getColumn(), values: values, formulas: range.getFormulas() };
}

function laserFocusReadPinnedRange_(source) {
  var workbook = SpreadsheetApp.getActiveSpreadsheet();
  if (source.workbookId !== workbook.getId()) throw new Error('The selected source belongs to another workbook. Select the source again.');
  var sheet = workbook.getSheetById(source.sheetId);
  if (!sheet) throw new Error('The selected source tab no longer exists. Select the source again.');
  return laserFocusSnapshot_(workbook, sheet.getRange(source.a1));
}

function laserFocusPinnedSelection_() {
  var source = laserFocusStoredSource_();
  if (!source) throw new Error('Select a donation table and click Read selected rows first.');
  var selection = laserFocusReadPinnedRange_(source);
  if (laserFocusHash_(selection) !== source.hash) throw new Error('The selected source cells changed. Read selected rows again, preview and import before reviewing a fresh report.');
  return selection;
}

function laserFocusAssertUnchanged_(selection) {
  if (laserFocusHash_(laserFocusReadPinnedRange_(selection)) !== laserFocusHash_(selection)) throw new Error('Source cells changed while this action was running. Refresh the selected rows and review a fresh report.');
}

function laserFocusRequest_(input) {
  var config = laserFocusConfig_(true);
  var response;
  try {
    response = UrlFetchApp.fetch(config.url + '/v1/command', { method: 'post', contentType: 'application/json', payload: JSON.stringify(input),
      headers: { Authorization: 'Bearer ' + config.token }, muteHttpExceptions: true, followRedirects: false, validateHttpsCertificates: true });
  } catch (error) { throw new Error('The Laser Focus bridge could not be reached. Check its HTTPS address and that the demo server is running.'); }
  var status = response.getResponseCode();
  if (status === 401 || status === 403) throw new Error('The bridge rejected this connection token. Update Settings and try again.');
  if (status >= 300 && status < 400) throw new Error('The bridge redirected the request. Enter its final HTTPS origin in Settings.');
  var result;
  try { result = JSON.parse(response.getContentText()); }
  catch (error) { throw new Error('The bridge returned an unexpected response. Check the demo server and retry.'); }
  if (status < 200 || status >= 300) {
    var message = result && typeof result.error === 'string' ? result.error.slice(0, 1500) : 'The bridge could not complete this action.';
    if (result && Array.isArray(result.issues)) message += ' ' + result.issues.slice(0, 6).map(function (issue) { return typeof issue.message === 'string' ? issue.message.slice(0, 500) : ''; }).join(' ');
    throw new Error(message);
  }
  return result;
}

function laserFocusStableJson_(value) {
  if (Array.isArray(value)) return '[' + value.map(laserFocusStableJson_).join(',') + ']';
  if (value !== null && typeof value === 'object') return '{' + Object.keys(value).filter(function (key) { return value[key] !== undefined; }).sort(function (a, b) { return a.localeCompare(b); }).map(function (key) { return JSON.stringify(key) + ':' + laserFocusStableJson_(value[key]); }).join(',') + '}';
  return JSON.stringify(value) || 'null';
}

function laserFocusHash_(value) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, laserFocusStableJson_(value), Utilities.Charset.UTF_8).map(function (byte) { return ('0' + ((byte + 256) % 256).toString(16)).slice(-2); }).join('');
}

function laserFocusLiteralCell_(value) { return /^[\s\uFEFF]*[=+@-]/.test(value) ? "'" + value : value; }

function laserFocusExportRows_(rows) {
  if (!Array.isArray(rows) || !rows.length || rows.length > 2000) throw new Error('The approved export has invalid rows.');
  var width = Array.isArray(rows[0]) ? rows[0].length : 0;
  if (!width || width > 16 || rows.some(function (row) { return !Array.isArray(row) || row.length !== width || row.some(function (cell) { return typeof cell !== 'string' || cell.length > 20000; }); })) throw new Error('The approved export has invalid cells.');
  return rows;
}

function laserFocusExportMarker_(sheet) {
  var markers = sheet.getDeveloperMetadata().filter(function (item) { return item.getKey() === LASER_FOCUS_EXPORT_KEY_; });
  if (markers.length !== 1) return null;
  try { return JSON.parse(markers[0].getValue()); } catch (error) { return null; }
}

function laserFocusVerifyWrittenRows_(sheet, rows) {
  var range = sheet.getRange(1, 1, rows.length, rows[0].length);
  var values = range.getValues();
  var formulas = range.getFormulas();
  for (var r = 0; r < rows.length; r++) for (var c = 0; c < rows[r].length; c++) {
    if (formulas[r][c] || (values[r][c] !== rows[r][c] && values[r][c] !== laserFocusLiteralCell_(rows[r][c]))) throw new Error('The report tab contents do not match the approved export. Laser Focus will not overwrite them.');
  }
}
